import React, { useState, useEffect, useMemo, useRef } from 'react';
import { 
  Plus, Search, Calendar, User, Briefcase, Filter, LayoutGrid, List, 
  CheckCircle2, Clock, AlertCircle, XCircle, MoreVertical, Trash2, Edit2, PlayCircle, 
  ChevronRight, GripVertical, Paperclip, MessageSquare, CheckSquare, X, BarChart2
} from 'lucide-react';
import { format, isToday, isThisWeek, isPast, parseISO } from 'date-fns';
import { ptBR } from 'date-fns/locale';
import { collection, query, where, onSnapshot, addDoc, updateDoc, deleteDoc, doc, serverTimestamp, getDocs, orderBy } from 'firebase/firestore';
import { db, auth } from '../../lib/firebase';
import { Card, CardContent } from '../../components/ui/card';
import { Button } from '../../components/ui/button';
import { Input } from '../../components/ui/input';
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogFooter, DialogClose } from '../../components/ui/dialog';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '../../components/ui/select';
import { Textarea } from '../../components/ui/textarea';
import { Checkbox } from '../../components/ui/checkbox';
import { Label } from '../../components/ui/label';
import { cn } from '../../lib/utils';
import { useTheme } from 'next-themes';
import { PieChart, Pie, Cell, BarChart, Bar, XAxis, YAxis, Tooltip as RechartsTooltip, ResponsiveContainer, LineChart, Line, Legend } from 'recharts';

type TaskStatus = 'a_fazer' | 'em_andamento' | 'aguardando' | 'concluido' | 'cancelado';
type TaskPriority = 'urgente' | 'alta' | 'media' | 'baixa';

interface Task {
  id: string;
  title: string;
  description: string;
  companyId: string | null;
  companyName: string | null;
  salesChannel: string | null;
  responsible: string;
  priority: TaskPriority;
  status: TaskStatus;
  startDate: string | null;
  dueDate: string | null;
  reminderEnabled: boolean;
  reminderType: string | null;
  progress: number;
  labels: string[];
  attachments: string[];
  commentsCount: number;
  createdAt: any;
  updatedAt: any;
}

interface Subtask {
  id: string;
  title: string;
  completed: boolean;
  createdAt: any;
}

interface Comment {
  id: string;
  user: string;
  message: string;
  createdAt: any;
}

interface Company {
  id: string;
  tradeName: string;
}

interface SalesChannel {
  id: string;
  accountName: string;
}

const STATUS_CONFIG = {
  a_fazer: { label: 'A Fazer', color: 'text-slate-500', bg: 'bg-slate-100 dark:bg-slate-800', border: 'border-slate-200 dark:border-slate-700', icon: Clock },
  em_andamento: { label: 'Em Andamento', color: 'text-blue-500', bg: 'bg-blue-100 dark:bg-blue-900/30', border: 'border-blue-200 dark:border-blue-800', icon: PlayCircle },
  aguardando: { label: 'Aguardando', color: 'text-amber-500', bg: 'bg-amber-100 dark:bg-amber-900/30', border: 'border-amber-200 dark:border-amber-800', icon: AlertCircle },
  concluido: { label: 'Concluído', color: 'text-emerald-500', bg: 'bg-emerald-100 dark:bg-emerald-900/30', border: 'border-emerald-200 dark:border-emerald-800', icon: CheckCircle2 },
  cancelado: { label: 'Cancelado', color: 'text-red-500', bg: 'bg-red-100 dark:bg-red-900/30', border: 'border-red-200 dark:border-red-800', icon: XCircle }
};

const PRIORITY_CONFIG = {
  urgente: { label: 'Urgente', color: 'text-red-500', bg: 'bg-red-100 dark:bg-red-900/30' },
  alta: { label: 'Alta', color: 'text-orange-500', bg: 'bg-orange-100 dark:bg-orange-900/30' },
  media: { label: 'Média', color: 'text-amber-500', bg: 'bg-amber-100 dark:bg-amber-900/30' },
  baixa: { label: 'Baixa', color: 'text-emerald-500', bg: 'bg-emerald-100 dark:bg-emerald-900/30' }
};

const LABEL_COLORS = [
  'bg-slate-200 text-slate-700 dark:bg-slate-800 dark:text-slate-300',
  'bg-red-200 text-red-700 dark:bg-red-900/40 dark:text-red-300',
  'bg-orange-200 text-orange-700 dark:bg-orange-900/40 dark:text-orange-300',
  'bg-amber-200 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300',
  'bg-emerald-200 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300',
  'bg-blue-200 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300',
  'bg-indigo-200 text-indigo-700 dark:bg-indigo-900/40 dark:text-indigo-300',
  'bg-violet-200 text-violet-700 dark:bg-violet-900/40 dark:text-violet-300',
  'bg-pink-200 text-pink-700 dark:bg-pink-900/40 dark:text-pink-300',
];

const PREDEFINED_LABELS = ['Marketplace', 'Produção', 'Financeiro', 'Urgente', 'Produto Novo', 'Fornecedor', 'ADS', 'Estoque', 'Shopee', 'Mercado Livre', 'TikTok', 'Shein', 'Marketing', 'Conteúdo', 'Foto', 'Vídeo', 'Lançamento', 'Meta', 'Compras'];

export default function Tarefas() {
  const { theme } = useTheme();
  const isDark = theme === 'dark';
  
  const [tasks, setTasks] = useState<Task[]>([]);
  const [companies, setCompanies] = useState<Company[]>([]);
  const [channels, setChannels] = useState<SalesChannel[]>([]);
  
  const [viewMode, setViewMode] = useState<'kanban' | 'list' | 'dashboard'>('kanban');
  const [search, setSearch] = useState('');
  const [filterStatus, setFilterStatus] = useState<string>('todos');
  const [filterPriority, setFilterPriority] = useState<string>('todas');
  
  const [isTaskModalOpen, setIsTaskModalOpen] = useState(false);
  const [isDetailModalOpen, setIsDetailModalOpen] = useState(false);
  const [selectedTask, setSelectedTask] = useState<Task | null>(null);
  const [subtasks, setSubtasks] = useState<Subtask[]>([]);
  
  // Task Form
  const [title, setTitle] = useState('');
  const [description, setDescription] = useState('');
  const [companyId, setCompanyId] = useState('');
  const [salesChannel, setSalesChannel] = useState('');
  const [responsible, setResponsible] = useState('');
  const [priority, setPriority] = useState<TaskPriority>('media');
  const [status, setStatus] = useState<TaskStatus>('a_fazer');
  const [startDate, setStartDate] = useState('');
  const [dueDate, setDueDate] = useState('');
  const [labels, setLabels] = useState<string[]>([]);
  
  const [draggedItem, setDraggedItem] = useState<string | null>(null);

  useEffect(() => {
    const user = auth.currentUser;
    if (!user) return;

    // Load Tasks
    const qTasks = query(collection(db, 'tasks'), where('userId', '==', user.uid));
    const uTasks = onSnapshot(qTasks, (snap) => {
      setTasks(snap.docs.map(doc => ({ id: doc.id, ...doc.data() } as Task)));
    });

    // Load Companies
    const qCompanies = query(collection(db, 'companies'), where('userId', '==', user.uid));
    const uCompanies = onSnapshot(qCompanies, (snap) => {
      setCompanies(snap.docs.map(doc => ({ id: doc.id, ...doc.data() } as Company)));
    });

    // Load Channels
    const qChannels = query(collection(db, 'sales_channels'), where('userId', '==', user.uid));
    const uChannels = onSnapshot(qChannels, (snap) => {
      setChannels(snap.docs.map(doc => ({ id: doc.id, ...doc.data() } as SalesChannel)));
    });

    return () => {
      uTasks();
      uCompanies();
      uChannels();
    };
  }, []);

  const loadSubtasks = async (taskId: string) => {
    const q = query(collection(db, `tasks/${taskId}/subtasks`), orderBy('createdAt', 'asc'));
    const snap = await getDocs(q);
    setSubtasks(snap.docs.map(doc => ({ id: doc.id, ...doc.data() } as Subtask)));
  };

  const handleOpenNewTask = () => {
    setSelectedTask(null);
    setTitle('');
    setDescription('');
    setCompanyId('');
    setSalesChannel('');
    setResponsible('');
    setPriority('media');
    setStatus('a_fazer');
    setStartDate('');
    setDueDate('');
    setLabels([]);
    setSubtasks([]);
    setIsTaskModalOpen(true);
  };

  const handleOpenEditTask = (task: Task) => {
    setSelectedTask(task);
    setTitle(task.title);
    setDescription(task.description);
    setCompanyId(task.companyId || '');
    setSalesChannel(task.salesChannel || '');
    setResponsible(task.responsible);
    setPriority(task.priority);
    setStatus(task.status);
    setStartDate(task.startDate || '');
    setDueDate(task.dueDate || '');
    setLabels(task.labels || []);
    loadSubtasks(task.id);
    setIsTaskModalOpen(true);
    setIsDetailModalOpen(false);
  };

  const handleSaveTask = async () => {
    const user = auth.currentUser;
    if (!user || !title.trim()) return;

    const companyName = companies.find(c => c.id === companyId)?.tradeName || null;
    
    // Subtask progress
    const totalSubtasks = subtasks.length;
    const completedSubtasks = subtasks.filter(s => s.completed).length;
    const progress = totalSubtasks > 0 ? Math.round((completedSubtasks / totalSubtasks) * 100) : 0;

    const taskData = {
      userId: user.uid,
      title,
      description,
      companyId: companyId || null,
      companyName,
      salesChannel: salesChannel || null,
      responsible,
      priority,
      status,
      startDate: startDate || null,
      dueDate: dueDate || null,
      reminderEnabled: false,
      reminderType: null,
      progress,
      labels,
      attachments: [],
      commentsCount: 0,
      updatedAt: serverTimestamp()
    };

    let taskId = selectedTask?.id;

    if (taskId) {
      await updateDoc(doc(db, 'tasks', taskId), taskData);
    } else {
      const docRef = await addDoc(collection(db, 'tasks'), {
        ...taskData,
        createdAt: serverTimestamp()
      });
      taskId = docRef.id;
    }

    // Handle Subtasks Sync
    const subtasksRef = collection(db, `tasks/${taskId}/subtasks`);
    const existingSubtasks = await getDocs(query(subtasksRef));
    
    // Simple sync: delete all and recreate for simplified subtask management
    for (const doc of existingSubtasks.docs) {
      await deleteDoc(doc.ref);
    }
    
    for (const st of subtasks) {
      await addDoc(subtasksRef, {
        title: st.title,
        completed: st.completed,
        createdAt: serverTimestamp(),
        userId: user.uid
      });
    }

    setIsTaskModalOpen(false);
  };

  const handleTaskStatusChange = async (taskId: string, newStatus: TaskStatus) => {
    await updateDoc(doc(db, 'tasks', taskId), { status: newStatus, updatedAt: serverTimestamp() });
  };

  const handleDragStart = (e: React.DragEvent, taskId: string) => {
    setDraggedItem(taskId);
    e.dataTransfer.setData('taskId', taskId);
    e.dataTransfer.effectAllowed = 'move';
  };

  const handleDragOver = (e: React.DragEvent) => {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
  };

  const handleDrop = (e: React.DragEvent, newStatus: TaskStatus) => {
    e.preventDefault();
    const taskId = e.dataTransfer.getData('taskId');
    if (taskId && draggedItem) {
      handleTaskStatusChange(taskId, newStatus);
    }
    setDraggedItem(null);
  };

  const addSubtask = (title: string) => {
    if (!title.trim()) return;
    setSubtasks([...subtasks, { id: Date.now().toString(), title, completed: false, createdAt: new Date() }]);
  };

  const toggleSubtask = (id: string) => {
    setSubtasks(subtasks.map(s => s.id === id ? { ...s, completed: !s.completed } : s));
  };
  
  const removeSubtask = (id: string) => {
    setSubtasks(subtasks.filter(s => s.id !== id));
  };

  const toggleLabel = (lbl: string) => {
    if (labels.includes(lbl)) {
      setLabels(labels.filter(l => l !== lbl));
    } else {
      setLabels([...labels, lbl]);
    }
  };

  const filteredTasks = useMemo(() => {
    return tasks.filter(t => {
      const matchSearch = t.title.toLowerCase().includes(search.toLowerCase()) || 
                          t.description?.toLowerCase().includes(search.toLowerCase());
      const matchStatus = filterStatus === 'todos' || t.status === filterStatus;
      const matchPriority = filterPriority === 'todas' || t.priority === filterPriority;
      return matchSearch && matchStatus && matchPriority;
    });
  }, [tasks, search, filterStatus, filterPriority]);

  const cardsStats = useMemo(() => {
    return {
      total: tasks.length,
      emAndamento: tasks.filter(t => t.status === 'em_andamento').length,
      concluidas: tasks.filter(t => t.status === 'concluido').length,
      atrasadas: tasks.filter(t => t.dueDate && isPast(parseISO(t.dueDate)) && t.status !== 'concluido' && t.status !== 'cancelado').length,
      altaPrioridade: tasks.filter(t => t.priority === 'urgente' || t.priority === 'alta').length,
      venceHoje: tasks.filter(t => t.dueDate && isToday(parseISO(t.dueDate))).length,
      venceSemana: tasks.filter(t => t.dueDate && isThisWeek(parseISO(t.dueDate))).length,
      minhaResponsabilidade: tasks.filter(t => t.responsible === auth.currentUser?.email || t.responsible.toLowerCase().includes('mim')).length,
    }
  }, [tasks]);

  const getLabelColor = (lbl: string) => {
    let hash = 0;
    for (let i = 0; i < lbl.length; i++) hash = lbl.charCodeAt(i) + ((hash << 5) - hash);
    return LABEL_COLORS[Math.abs(hash) % LABEL_COLORS.length];
  };

  const renderKanbanCol = (statusKey: TaskStatus, config: any) => {
    const colTasks = filteredTasks.filter(t => t.status === statusKey).sort((a,b) => {
      const priorities = { urgente: 4, alta: 3, media: 2, baixa: 1 };
      return priorities[b.priority] - priorities[a.priority];
    });

    const Icon = config.icon;

    return (
      <div 
        key={statusKey} 
        className={cn("flex flex-col min-w-[300px] w-full max-w-[350px] shrink-0 rounded-2xl border p-3", config.bg, config.border)}
        onDragOver={handleDragOver}
        onDrop={(e) => handleDrop(e, statusKey)}
      >
        <div className="flex items-center justify-between mb-4 px-1">
          <div className="flex items-center gap-2">
            <Icon className={cn("w-5 h-5", config.color)} />
            <h3 className={cn("font-black tracking-wider uppercase text-sm", config.color)}>{config.label}</h3>
          </div>
          <span className="bg-background/50 text-foreground font-black text-xs px-2 py-1 rounded-lg shadow-sm border border-border/50">{colTasks.length}</span>
        </div>
        
        <div className="flex flex-col gap-3 flex-1 overflow-y-auto hide-scrollbar pb-10">
          {colTasks.map(task => (
            <div 
              key={task.id}
              draggable
              onDragStart={(e) => handleDragStart(e, task.id)}
              onClick={() => { setSelectedTask(task); loadSubtasks(task.id); setIsDetailModalOpen(true); }}
              className="cursor-grab active:cursor-grabbing border-border shadow-sm hover:shadow-md hover:border-border transition-all p-4 rounded-xl flex flex-col gap-3 border border-transparent group relative"
            >
              <div className="flex flex-wrap gap-1">
                <span className={cn("text-[9px] font-black uppercase px-2 py-0.5 rounded-full", PRIORITY_CONFIG[task.priority].bg, PRIORITY_CONFIG[task.priority].color)}>
                  {PRIORITY_CONFIG[task.priority].label}
                </span>
                {task.labels?.slice(0,2).map(l => (
                  <span key={l} className={cn("text-[9px] font-bold px-2 py-0.5 rounded-full truncate max-w-[100px]", getLabelColor(l))}>{l}</span>
                ))}
                {(task.labels?.length || 0) > 2 && (
                  <span className="text-[9px] font-bold px-2 py-0.5 rounded-full bg-muted text-muted-foreground">+{task.labels.length - 2}</span>
                )}
              </div>
              
              <h4 className="font-bold text-sm leading-tight text-foreground">{task.title}</h4>
              
              <div className="flex flex-wrap gap-x-3 gap-y-1 mt-auto">
                {task.companyName && (
                  <div className="flex items-center gap-1 text-xs text-muted-foreground font-medium">
                    <Briefcase className="w-3 h-3" />
                    <span className="truncate max-w-[100px]">{task.companyName}</span>
                  </div>
                )}
                {task.dueDate && (
                  <div className={cn("flex items-center gap-1 text-xs font-medium", 
                    isPast(parseISO(task.dueDate)) && task.status !== 'concluido' ? 'text-red-500 font-bold' : 'text-muted-foreground'
                  )}>
                    <Calendar className="w-3 h-3" />
                    <span>{format(parseISO(task.dueDate), 'dd/MM')}</span>
                  </div>
                )}
              </div>

              {(task.progress > 0) && (
                <div className="w-full bg-muted rounded-full h-1.5 overflow-hidden mt-1">
                  <div className="bg-indigo-500 h-full rounded-full transition-all" style={{ width: `${task.progress}%` }}></div>
                </div>
              )}
              
              <div className="flex items-center justify-between pt-2 border-t border-border mt-1">
                <div className="flex items-center gap-1.5 text-xs font-medium text-muted-foreground bg-muted/50 px-2 py-1 rounded-md">
                  <User className="w-3 h-3" />
                  <span className="truncate max-w-[80px]">{task.responsible || 'Sem resp.'}</span>
                </div>
                <div className="flex gap-2 text-muted-foreground">
                  {task.commentsCount > 0 && (
                    <div className="flex items-center gap-1 text-[10px] font-bold">
                      <MessageSquare className="w-3.5 h-3.5" />
                      <span>{task.commentsCount}</span>
                    </div>
                  )}
                  {task.attachments && task.attachments.length > 0 && (
                    <div className="flex items-center gap-1 text-[10px] font-bold">
                      <Paperclip className="w-3.5 h-3.5" />
                      <span>{task.attachments.length}</span>
                    </div>
                  )}
                </div>
              </div>
            </div>
          ))}
          {colTasks.length === 0 && (
            <div className="h-24 border-2 border-dashed border-border/50 rounded-xl flex items-center justify-center">
              <span className="text-xs font-medium text-muted-foreground">Solte tarefas aqui</span>
            </div>
          )}
        </div>
      </div>
    );
  };

  const renderListView = () => {
    return (
      <div className="overflow-x-auto w-full pb-4">
        <table className="w-full min-w-[800px] border-collapse text-sm">
          <thead>
            <tr className="border-b border-border text-left text-xs font-bold text-muted-foreground uppercase tracking-wider">
              <th className="py-4 px-4 font-black">Título da Tarefa</th>
              <th className="py-4 px-4 font-black">Empresa / Canal</th>
              <th className="py-4 px-4 font-black text-center">Progresso</th>
              <th className="py-4 px-4 font-black">Responsável</th>
              <th className="py-4 px-4 font-black">Prioridade</th>
              <th className="py-4 px-4 font-black">Vencimento</th>
              <th className="py-4 px-4 font-black text-right">Ações</th>
            </tr>
          </thead>
          <tbody>
            {filteredTasks.length === 0 ? (
              <tr><td colSpan={7} className="text-center py-10 text-muted-foreground font-medium">Nenhuma tarefa encontrada</td></tr>
            ) : filteredTasks.map(task => (
              <tr key={task.id} className="border-b border-border/50 hover:bg-muted/30 transition-colors cursor-pointer" onClick={() => { setSelectedTask(task); loadSubtasks(task.id); setIsDetailModalOpen(true); }}>
                <td className="py-3 px-4">
                  <div className="font-bold text-foreground text-[15px]">{task.title}</div>
                  <div className="flex gap-1 mt-1">
                    {task.labels?.slice(0, 3).map(l => (
                      <span key={l} className={cn("text-[9px] font-bold px-1.5 py-0.5 rounded-sm", getLabelColor(l))}>{l}</span>
                    ))}
                  </div>
                </td>
                <td className="py-3 px-4">
                  <div className="font-semibold text-foreground text-xs">{task.companyName || '-'}</div>
                  <div className="text-[10px] text-muted-foreground">{task.salesChannel || ''}</div>
                </td>
                <td className="py-3 px-4 text-center">
                  <div className="flex items-center gap-2 max-w-[120px] mx-auto">
                    <div className="w-full bg-muted rounded-full h-2 overflow-hidden">
                      <div className="bg-indigo-500 h-full rounded-full transition-all" style={{ width: `${task.progress}%` }}></div>
                    </div>
                    <span className="text-[10px] font-bold w-6">{task.progress}%</span>
                  </div>
                </td>
                <td className="py-3 px-4">
                  <div className="flex items-center gap-2">
                    <div className="w-6 h-6 rounded-full bg-indigo-100 text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-300 flex items-center justify-center font-bold text-[10px]">
                      {task.responsible ? task.responsible.substring(0,2).toUpperCase() : '?'}
                    </div>
                    <span className="font-medium text-xs truncate max-w-[100px]">{task.responsible || 'Sem resp.'}</span>
                  </div>
                </td>
                <td className="py-3 px-4">
                  <span className={cn("text-[10px] font-black uppercase px-2 py-1 rounded-md", PRIORITY_CONFIG[task.priority].bg, PRIORITY_CONFIG[task.priority].color)}>
                    {PRIORITY_CONFIG[task.priority].label}
                  </span>
                </td>
                <td className="py-3 px-4">
                  {task.dueDate ? (
                    <div className={cn("flex items-center gap-1.5 font-bold text-xs", isPast(parseISO(task.dueDate)) && task.status !== 'concluido' ? 'text-red-500' : 'text-muted-foreground')}>
                      <Calendar className="w-3.5 h-3.5" />
                      {format(parseISO(task.dueDate), 'dd/MM/yyyy')}
                    </div>
                  ) : '-'}
                </td>
                <td className="py-3 px-4 text-right">
                  <Button variant="ghost" size="icon" className="h-8 w-8 text-muted-foreground hover:text-indigo-600" onClick={(e) => { e.stopPropagation(); handleOpenEditTask(task); }}>
                    <Edit2 className="w-4 h-4" />
                  </Button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    );
  };

  const renderDashboard = () => {
    // 1. Tarefas por Status (Donut)
    const statusData = Object.entries(STATUS_CONFIG).map(([k,v]) => ({
      name: v.label,
      value: filteredTasks.filter(t => t.status === k).length,
      fill: k === 'concluido' ? '#10b981' : k === 'em_andamento' ? '#3b82f6' : k === 'aguardando' ? '#f59e0b' : k === 'cancelado' ? '#ef4444' : '#64748b'
    })).filter(d => d.value > 0);

    // 2. Tarefas por Prioridade (Barra)
    const priorityData = Object.entries(PRIORITY_CONFIG).map(([k,v]) => ({
      name: v.label,
      Tarefas: filteredTasks.filter(t => t.priority === k).length,
      fill: k === 'urgente' ? '#ef4444' : k === 'alta' ? '#f97316' : k === 'media' ? '#f59e0b' : '#10b981'
    }));

    // 3. Tarefas por Responsavel (Barra)
    const responsibleMap = new Map<string, number>();
    filteredTasks.forEach(t => {
       const resp = t.responsible || 'Sem resp.';
       responsibleMap.set(resp, (responsibleMap.get(resp) || 0) + 1);
    });
    const responsibleData = Array.from(responsibleMap.entries()).map(([name, value]) => ({ name, value })).sort((a,b) => b.value - a.value).slice(0, 10);

    // 4. Tarefas por Empresa
    const companyMap = new Map<string, number>();
    filteredTasks.forEach(t => {
       if (t.companyName) {
         companyMap.set(t.companyName, (companyMap.get(t.companyName) || 0) + 1);
       }
    });
    const companyData = Array.from(companyMap.entries()).map(([name, Tarefas]) => ({ name, Tarefas })).sort((a,b) => b.Tarefas - a.Tarefas).slice(0, 10);

    return (
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pb-8 overflow-y-auto hide-scrollbar">
         <Card className="rounded-[1.5rem] border-border shadow-sm">
            <CardContent className="p-6 h-[300px] flex flex-col">
               <h3 className="font-black text-foreground mb-4 uppercase tracking-wider text-xs">Tarefas por Status</h3>
               <div className="flex-1 flex items-center justify-center -ml-4">
                  <ResponsiveContainer width="100%" height="100%">
                     <PieChart>
                        <Pie data={statusData} innerRadius={60} outerRadius={80} paddingAngle={2} dataKey="value" stroke="none" labelLine={false} label={({name, percent}) => percent > 0.05 ? `${name} ${(percent*100).toFixed(0)}%` : ''}>
                           {statusData.map((entry, index) => <Cell key={`cell-${index}`} fill={entry.fill} />)}
                        </Pie>
                        <RechartsTooltip contentStyle={{ borderRadius: '1rem', border: 'none', boxShadow: '0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)' }} />
                     </PieChart>
                  </ResponsiveContainer>
               </div>
            </CardContent>
         </Card>

         <Card className="rounded-[1.5rem] border-border shadow-sm">
            <CardContent className="p-6 h-[300px] flex flex-col">
               <h3 className="font-black text-foreground mb-4 uppercase tracking-wider text-xs">Tarefas por Prioridade</h3>
               <div className="flex-1 -ml-6">
                  <ResponsiveContainer width="100%" height="100%">
                     <BarChart data={priorityData} margin={{ top: 10, right: 10, left: 0, bottom: 0 }}>
                        <XAxis dataKey="name" fontSize={10} tickLine={false} axisLine={false} />
                        <YAxis fontSize={10} tickLine={false} axisLine={false} />
                        <RechartsTooltip cursor={{ fill: 'transparent' }} contentStyle={{ borderRadius: '1rem', border: 'none', boxShadow: '0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)' }} />
                        <Bar dataKey="Tarefas" radius={[4, 4, 0, 0]}>
                          {priorityData.map((entry, index) => <Cell key={`cell-${index}`} fill={entry.fill} />)}
                        </Bar>
                     </BarChart>
                  </ResponsiveContainer>
               </div>
            </CardContent>
         </Card>

         <Card className="rounded-[1.5rem] border-border shadow-sm">
            <CardContent className="p-6 h-[300px] flex flex-col">
               <h3 className="font-black text-foreground mb-4 uppercase tracking-wider text-xs">Tarefas por Responsável</h3>
               <div className="flex-1 -ml-6">
                  <ResponsiveContainer width="100%" height="100%">
                     <BarChart data={responsibleData} margin={{ top: 10, right: 10, left: 0, bottom: 0 }}>
                        <XAxis dataKey="name" fontSize={10} tickLine={false} axisLine={false} />
                        <YAxis fontSize={10} tickLine={false} axisLine={false} />
                        <RechartsTooltip cursor={{ fill: 'transparent' }} contentStyle={{ borderRadius: '1rem', border: 'none', boxShadow: '0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)' }} />
                        <Bar dataKey="value" fill="#6366f1" radius={[4, 4, 0, 0]} />
                     </BarChart>
                  </ResponsiveContainer>
               </div>
            </CardContent>
         </Card>

         <Card className="rounded-[1.5rem] border-border shadow-sm md:col-span-2 lg:col-span-3">
            <CardContent className="p-6 h-[300px] flex flex-col">
               <h3 className="font-black text-foreground mb-4 uppercase tracking-wider text-xs">Tarefas por Empresa</h3>
               <div className="flex-1 -ml-6">
                  <ResponsiveContainer width="100%" height="100%">
                     <BarChart data={companyData} margin={{ top: 10, right: 10, left: 0, bottom: 0 }}>
                        <XAxis dataKey="name" fontSize={10} tickLine={false} axisLine={false} />
                        <YAxis fontSize={10} tickLine={false} axisLine={false} />
                        <RechartsTooltip cursor={{ fill: 'transparent' }} contentStyle={{ borderRadius: '1rem', border: 'none', boxShadow: '0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)' }} />
                        <Bar dataKey="Tarefas" fill="#8b5cf6" radius={[4, 4, 0, 0]} />
                     </BarChart>
                  </ResponsiveContainer>
               </div>
            </CardContent>
         </Card>
      </div>
    );
  };

  return (
    <div className="flex-1 p-4 md:p-8 pt-6 lg:max-w-7xl mx-auto w-full transition-all flex flex-col gap-6">
      <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
         <div>
            <h1 className="text-4xl font-black tracking-tight text-foreground -ml-[2px] leading-tight">Tarefas</h1>
            <p className="text-muted-foreground font-medium mt-1">Gerencie atividades, prioridades e responsabilidades da operação.</p>
         </div>
         <div className="flex items-center gap-3 w-full md:w-auto">
            <div className="flex items-center bg-muted/50 p-1 rounded-xl w-full md:w-auto">
               <Button variant={viewMode === 'kanban' ? 'secondary' : 'ghost'} size="sm" onClick={() => setViewMode('kanban')} className="rounded-lg font-bold">
                  <LayoutGrid className="w-4 h-4 mr-2" /> Kanban
               </Button>
               <Button variant={viewMode === 'list' ? 'secondary' : 'ghost'} size="sm" onClick={() => setViewMode('list')} className="rounded-lg font-bold">
                  <List className="w-4 h-4 mr-2" /> Lista
               </Button>
               <Button variant={viewMode === 'dashboard' ? 'secondary' : 'ghost'} size="sm" onClick={() => setViewMode('dashboard')} className="rounded-lg font-bold">
                  <BarChart2 className="w-4 h-4 mr-2" /> Gráficos
               </Button>
            </div>
            <Button onClick={handleOpenNewTask} className="rounded-xl h-11 px-6 font-black tracking-wider uppercase text-sm shadow-md bg-indigo-600 hover:bg-indigo-700 transition-all shrink-0">
               <Plus className="w-4 h-4 mr-2" /> Nova Tarefa
            </Button>
         </div>
      </div>

      {/* Cards de Resumo */}
      <div className="flex gap-4 overflow-x-auto hide-scrollbar pb-2 w-full snap-x">
         <Card className="rounded-[1.5rem] bg-indigo-600 border-none text-white shadow-md min-w-[160px] shrink-0 snap-start">
           <CardContent className="p-4 flex flex-col justify-center">
             <div className="text-[10px] font-bold text-indigo-200 uppercase tracking-wider mb-1">Total Tarefas</div>
             <div className="text-3xl font-black">{cardsStats.total}</div>
           </CardContent>
         </Card>
         <Card className="rounded-[1.5rem] border-border shadow-sm min-w-[160px] shrink-0 snap-start">
           <CardContent className="p-4 flex flex-col justify-center">
             <div className="text-[10px] font-bold text-blue-500 uppercase tracking-wider mb-1">Em Andamento</div>
             <div className="text-3xl font-black flex items-end gap-2">
               {cardsStats.emAndamento} <span className="text-sm font-bold text-muted-foreground mb-1">/{cardsStats.total}</span>
             </div>
           </CardContent>
         </Card>
         <Card className="rounded-[1.5rem] border-border shadow-sm min-w-[160px] shrink-0 snap-start">
           <CardContent className="p-4 flex flex-col justify-center">
             <div className="text-[10px] font-bold text-emerald-600 uppercase tracking-wider mb-1">Concluídas</div>
             <div className="text-3xl font-black text-foreground">{cardsStats.concluidas}</div>
           </CardContent>
         </Card>
         <Card className="rounded-[1.5rem] border-border shadow-sm min-w-[160px] shrink-0 snap-start">
           <CardContent className="p-4 flex flex-col justify-center">
             <div className="text-[10px] font-bold text-red-500 uppercase tracking-wider mb-1">Atrasadas</div>
             <div className="text-3xl font-black text-foreground">{cardsStats.atrasadas}</div>
           </CardContent>
         </Card>
         <Card className="rounded-[1.5rem] border-border shadow-sm min-w-[160px] shrink-0 snap-start">
           <CardContent className="p-4 flex flex-col justify-center">
             <div className="text-[10px] font-bold text-orange-500 uppercase tracking-wider mb-1">Alta Prioridade</div>
             <div className="text-3xl font-black text-foreground">{cardsStats.altaPrioridade}</div>
           </CardContent>
         </Card>
         <Card className="rounded-[1.5rem] border-border shadow-sm min-w-[160px] shrink-0 snap-start">
           <CardContent className="p-4 flex flex-col justify-center">
             <div className="text-[10px] font-bold text-amber-500 uppercase tracking-wider mb-1">Vencem Hoje</div>
             <div className="text-3xl font-black text-foreground">{cardsStats.venceHoje}</div>
           </CardContent>
         </Card>
         <Card className="rounded-[1.5rem] border-border shadow-sm min-w-[160px] shrink-0 snap-start">
           <CardContent className="p-4 flex flex-col justify-center">
             <div className="text-[10px] font-bold text-violet-500 uppercase tracking-wider mb-1">Vencem Esta Semana</div>
             <div className="text-3xl font-black text-foreground">{cardsStats.venceSemana}</div>
           </CardContent>
         </Card>
         <Card className="rounded-[1.5rem] border-border shadow-sm min-w-[160px] shrink-0 snap-start cursor-pointer hover:border-indigo-500 transition-colors" onClick={() => setSearch('mim')}>
           <CardContent className="p-4 flex flex-col justify-center">
             <div className="text-[10px] font-bold text-indigo-500 uppercase tracking-wider mb-1">Minha Responsabilidade</div>
             <div className="text-3xl font-black text-foreground">{cardsStats.minhaResponsabilidade}</div>
           </CardContent>
         </Card>
      </div>

      {/* Toolbar */}
      <div className="flex flex-col md:flex-row gap-4 justify-between items-center p-2 px-4 rounded-[1.5rem] border border-border shadow-sm">
        <div className="relative w-full md:w-96 shrink-0">
          <Search className="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-muted-foreground" />
          <Input 
            value={search} onChange={e=>setSearch(e.target.value)}
            className="pl-12 h-12 w-full rounded-xl bg-muted/30 border-transparent font-medium" 
            placeholder="Buscar tarefas, descrições..." 
          />
        </div>
        <div className="flex gap-2 w-full md:w-auto overflow-x-auto hide-scrollbar">
          <Select value={filterStatus} onValueChange={setFilterStatus}>
            <SelectTrigger className="w-[180px] h-12 rounded-xl font-bold bg-muted/30 border-transparent"><SelectValue placeholder="Status" /></SelectTrigger>
            <SelectContent className="rounded-xl">
              <SelectItem value="todos">Todos os Status</SelectItem>
              {Object.entries(STATUS_CONFIG).map(([k,v]) => <SelectItem key={k} value={k}>{v.label}</SelectItem>)}
            </SelectContent>
          </Select>
          <Select value={filterPriority} onValueChange={setFilterPriority}>
            <SelectTrigger className="w-[180px] h-12 rounded-xl font-bold bg-muted/30 border-transparent"><SelectValue placeholder="Prioridade" /></SelectTrigger>
            <SelectContent className="rounded-xl">
              <SelectItem value="todas">Todas as Prioridades</SelectItem>
              {Object.entries(PRIORITY_CONFIG).map(([k,v]) => <SelectItem key={k} value={k}>{v.label}</SelectItem>)}
            </SelectContent>
          </Select>
        </div>
      </div>

      {/* Main Content Area */}
      <div className="flex-1 overflow-hidden flex flex-col">
          {viewMode === 'kanban' ? (
            <div className="flex gap-4 overflow-x-auto h-full items-start hide-scrollbar pb-6 px-1">
              {renderKanbanCol('a_fazer', STATUS_CONFIG.a_fazer)}
              {renderKanbanCol('em_andamento', STATUS_CONFIG.em_andamento)}
              {renderKanbanCol('aguardando', STATUS_CONFIG.aguardando)}
              {renderKanbanCol('concluido', STATUS_CONFIG.concluido)}
              {renderKanbanCol('cancelado', STATUS_CONFIG.cancelado)}
            </div>
          ) : viewMode === 'list' ? (
            <Card className="rounded-[1.5rem] border-border shadow-sm overflow-hidden">
              <CardContent className="p-0">
                {renderListView()}
              </CardContent>
            </Card>
          ) : (
             renderDashboard()
          )}
      </div>

      {/* Modal: Nova Tarefa / Editar Tarefa */}
      <Dialog open={isTaskModalOpen} onOpenChange={setIsTaskModalOpen}>
         <DialogContent className="rounded-3xl border-border max-w-4xl max-h-[90vh] overflow-y-auto p-0 flex flex-col hide-scrollbar">
            <div className="sticky top-0/80 backdrop-blur-md z-10 border-b border-border px-8 py-5 flex items-center justify-between">
              <div>
                <DialogTitle className="font-black text-2xl text-foreground">{selectedTask ? 'Editar Tarefa' : 'Nova Tarefa'}</DialogTitle>
                <p className="text-sm font-medium text-muted-foreground mt-1">Preencha os detalhes da tarefa para manter a equipe alinhada.</p>
              </div>
              <DialogClose className="rounded-full p-2 hover:bg-muted transition-colors"><X className="w-5 h-5 text-muted-foreground" /></DialogClose>
            </div>
            
            <div className="p-8 space-y-8 flex-1">
               {/* Secao 1 */}
               <div className="space-y-4">
                  <div className="space-y-2">
                     <label className="text-[11px] font-black uppercase tracking-wider text-muted-foreground">Título da Tarefa *</label>
                     <Input value={title} onChange={e=>setTitle(e.target.value)} autoFocus className="h-14 rounded-2xl font-black text-xl bg-muted/30 border-transparent placeholder:text-muted/50 focus-visible:ring-indigo-500" placeholder="Ex: Atualizar anúncios Mercado Livre" />
                  </div>
                  <div className="space-y-2">
                     <label className="text-[11px] font-black uppercase tracking-wider text-muted-foreground">Descrição</label>
                     <Textarea value={description} onChange={e=>setDescription(e.target.value)} className="min-h-[120px] rounded-2xl font-medium bg-muted/30 border-transparent resize-none focus-visible:ring-indigo-500" placeholder="Detalhes da tarefa..." />
                  </div>
               </div>

               <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                  {/* Empresa e Canal */}
                  <div className="space-y-4 bg-muted/20 p-5 rounded-3xl border border-border/50">
                     <div className="space-y-2">
                        <label className="text-[11px] font-black uppercase tracking-wider text-muted-foreground flex items-center gap-1.5"><Briefcase className="w-3.5 h-3.5" /> Vincular Empresa</label>
                        <Select value={companyId} onValueChange={setCompanyId}>
                           <SelectTrigger className="h-12 rounded-xl font-bold bg-background border-border shadow-sm"><SelectValue placeholder="Selecione (Opcional)" /></SelectTrigger>
                           <SelectContent className="rounded-xl">
                              <SelectItem value="none">Nenhuma</SelectItem>
                              {companies.map(c => <SelectItem key={c.id} value={c.id}>{c.tradeName}</SelectItem>)}
                           </SelectContent>
                        </Select>
                     </div>
                     <div className="space-y-2">
                        <label className="text-[11px] font-black uppercase tracking-wider text-muted-foreground">Vincular Canal de Venda</label>
                        <Select value={salesChannel} onValueChange={setSalesChannel}>
                           <SelectTrigger className="h-12 rounded-xl font-bold bg-background border-border shadow-sm"><SelectValue placeholder="Selecione (Opcional)" /></SelectTrigger>
                           <SelectContent className="rounded-xl">
                              <SelectItem value="none">Nenhum</SelectItem>
                              <SelectItem value="Mercado Livre">Mercado Livre</SelectItem>
                              <SelectItem value="Shopee">Shopee</SelectItem>
                              <SelectItem value="TikTok Shop">TikTok Shop</SelectItem>
                              <SelectItem value="Shein">Shein</SelectItem>
                              <SelectItem value="WhatsApp">WhatsApp</SelectItem>
                              <SelectItem value="Instagram">Instagram</SelectItem>
                              <SelectItem value="Loja Própria">Loja Própria</SelectItem>
                           </SelectContent>
                        </Select>
                     </div>
                  </div>

                  {/* Prioridade e Status */}
                  <div className="space-y-4 bg-muted/20 p-5 rounded-3xl border border-border/50">
                     <div className="space-y-2">
                        <label className="text-[11px] font-black uppercase tracking-wider text-muted-foreground">Prioridade</label>
                        <Select value={priority} onValueChange={(v: TaskPriority)=>setPriority(v)}>
                           <SelectTrigger className="h-12 rounded-xl font-bold bg-background border-border shadow-sm">
                             <SelectValue>
                               {<span className={cn("px-2 py-0.5 rounded-md text-[10px] uppercase font-black", PRIORITY_CONFIG[priority].bg, PRIORITY_CONFIG[priority].color)}>{PRIORITY_CONFIG[priority].label}</span>}
                             </SelectValue>
                           </SelectTrigger>
                           <SelectContent className="rounded-xl">
                              {Object.entries(PRIORITY_CONFIG).map(([k,v]) => (
                                <SelectItem key={k} value={k}>
                                  <span className={cn("px-2 py-0.5 rounded-md text-[10px] uppercase font-black", v.bg, v.color)}>{v.label}</span>
                                </SelectItem>
                              ))}
                           </SelectContent>
                        </Select>
                     </div>
                     <div className="space-y-2">
                        <label className="text-[11px] font-black uppercase tracking-wider text-muted-foreground">Status Inicial</label>
                        <Select value={status} onValueChange={(v: TaskStatus)=>setStatus(v)}>
                           <SelectTrigger className="h-12 rounded-xl font-bold bg-background border-border shadow-sm">
                             <SelectValue>
                               <span className={cn("px-2 py-0.5 rounded-md text-[10px] uppercase font-black", STATUS_CONFIG[status].bg, STATUS_CONFIG[status].color)}>{STATUS_CONFIG[status].label}</span>
                             </SelectValue>
                           </SelectTrigger>
                           <SelectContent className="rounded-xl">
                              {Object.entries(STATUS_CONFIG).map(([k,v]) => (
                                <SelectItem key={k} value={k}>
                                  <span className={cn("px-2 py-0.5 rounded-md text-[10px] uppercase font-black", v.bg, v.color)}>{v.label}</span>
                                </SelectItem>
                              ))}
                           </SelectContent>
                        </Select>
                     </div>
                  </div>
               </div>

               <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                  {/* Responsavel */}
                  <div className="space-y-2">
                    <label className="text-[11px] font-black uppercase tracking-wider text-muted-foreground flex items-center gap-1.5"><User className="w-3.5 h-3.5" /> Responsável</label>
                    <Input value={responsible} onChange={e=>setResponsible(e.target.value)} className="h-12 rounded-xl font-bold bg-background" placeholder="Nome ou setor" />
                  </div>
                  {/* Datas */}
                  <div className="space-y-2">
                    <label className="text-[11px] font-black uppercase tracking-wider text-muted-foreground flex items-center gap-1.5"><Calendar className="w-3.5 h-3.5" /> Data Início</label>
                    <Input type="date" value={startDate} onChange={e=>setStartDate(e.target.value)} className="h-12 rounded-xl font-bold bg-background text-sm" />
                  </div>
                  <div className="space-y-2">
                    <label className="text-[11px] font-black uppercase tracking-wider text-red-500/80 flex items-center gap-1.5"><AlertCircle className="w-3.5 h-3.5" /> Vencimento</label>
                    <Input type="date" value={dueDate} onChange={e=>setDueDate(e.target.value)} className="h-12 rounded-xl font-bold bg-red-50/50 border-red-200 dark:bg-red-900/10 text-sm focus-visible:ring-red-500" />
                  </div>
               </div>

               {/* Etiquetas */}
               <div className="space-y-3 pt-4 border-t border-border">
                 <label className="text-[11px] font-black uppercase tracking-wider text-muted-foreground">Etiquetas</label>
                 <div className="flex flex-wrap gap-2">
                   {PREDEFINED_LABELS.map(lbl => {
                     const isActive = labels.includes(lbl);
                     return (
                       <button 
                        key={lbl} onClick={() => toggleLabel(lbl)}
                        className={cn(
                          "px-3 py-1.5 rounded-lg text-xs font-bold transition-all border",
                          isActive ? cn("border-transparent shadow-sm", getLabelColor(lbl)) : "bg-transparent border-border text-muted-foreground hover:bg-muted"
                        )}
                       >
                         {lbl}
                       </button>
                     )
                   })}
                 </div>
               </div>

               {/* Subtarefas */}
               <div className="space-y-4 pt-4 border-t border-border">
                  <div className="flex items-center justify-between">
                    <label className="text-[11px] font-black uppercase tracking-wider text-muted-foreground flex items-center gap-1.5"><CheckSquare className="w-3.5 h-3.5" /> Subtarefas</label>
                    {subtasks.length > 0 && (
                      <span className="text-[10px] font-bold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-full">
                        {subtasks.filter(s=>s.completed).length} de {subtasks.length} ({Math.round((subtasks.filter(s=>s.completed).length / subtasks.length) * 100)}%)
                      </span>
                    )}
                  </div>
                  
                  <div className="flex flex-col gap-2">
                    {subtasks.map((st, i) => (
                      <div key={st.id} className="flex items-center gap-3 p-2 hover:bg-muted/50 rounded-xl transition-colors group">
                        <Checkbox checked={st.completed} onCheckedChange={() => toggleSubtask(st.id)} className="h-5 w-5 rounded-md border-muted-foreground/30 data-[state=checked]:bg-indigo-600 data-[state=checked]:border-indigo-600" />
                        <span className={cn("text-sm font-medium flex-1", st.completed ? "line-through text-muted-foreground" : "text-foreground")}>{st.title}</span>
                        <Button variant="ghost" size="icon" onClick={() => removeSubtask(st.id)} className="opacity-0 group-hover:opacity-100 h-8 w-8 text-muted-foreground hover:text-red-500">
                          <Trash2 className="w-4 h-4" />
                        </Button>
                      </div>
                    ))}
                  </div>

                  <div className="flex gap-2 relative">
                    <Input 
                      placeholder="Adicionar nova subtarefa..." 
                      className="h-12 rounded-xl bg-muted/30 border-transparent pr-12 text-sm font-medium focus-visible:ring-indigo-500"
                      onKeyDown={(e) => {
                        if (e.key === 'Enter' && e.currentTarget.value.trim()) {
                          addSubtask(e.currentTarget.value.trim());
                          e.currentTarget.value = '';
                        }
                      }}
                    />
                    <div className="absolute right-2 top-1/2 -translate-y-1/2 text-[10px] font-black text-muted-foreground">ENTER</div>
                  </div>
               </div>

            </div>
            
            <div className="p-6 border-t border-border bg-muted/20 flex justify-end gap-3 sticky bottom-0">
               <Button variant="ghost" onClick={() => setIsTaskModalOpen(false)} className="rounded-xl font-bold">Cancelar</Button>
               <Button onClick={handleSaveTask} className="rounded-xl px-10 h-12 font-black uppercase tracking-wider bg-indigo-600 hover:bg-indigo-700 shadow-md">Salvar Tarefa</Button>
            </div>
         </DialogContent>
      </Dialog>


      {/* Modal: Detalhes da Tarefa */}
      <Dialog open={isDetailModalOpen} onOpenChange={setIsDetailModalOpen}>
        <DialogContent className="rounded-3xl border-border max-w-3xl max-h-[90vh] overflow-y-auto p-0 flex flex-col hide-scrollbar">
           {selectedTask && (
             <>
              <div className="sticky top-0/80 backdrop-blur-md z-10 border-b border-border px-8 py-5 flex items-center justify-between">
                <div className="flex items-center gap-3">
                  <span className={cn("px-3 py-1 rounded-lg text-xs uppercase font-black shadow-sm", STATUS_CONFIG[selectedTask.status].bg, STATUS_CONFIG[selectedTask.status].color)}>
                    {STATUS_CONFIG[selectedTask.status].label}
                  </span>
                  <span className={cn("px-3 py-1 rounded-lg text-xs uppercase font-black border", PRIORITY_CONFIG[selectedTask.priority].color)}>
                    {PRIORITY_CONFIG[selectedTask.priority].label}
                  </span>
                </div>
                <div className="flex items-center gap-2">
                  <Button variant="outline" size="sm" onClick={() => handleOpenEditTask(selectedTask)} className="rounded-xl font-bold h-9">Editar Tarefa</Button>
                  <DialogClose className="rounded-full p-2 hover:bg-muted transition-colors"><X className="w-5 h-5 text-muted-foreground" /></DialogClose>
                </div>
              </div>
              
              <div className="p-8 space-y-8 flex-1">
                <div>
                  <h2 className="text-3xl font-black text-foreground leading-tight">{selectedTask.title}</h2>
                  {selectedTask.labels && selectedTask.labels.length > 0 && (
                    <div className="flex flex-wrap gap-2 mt-4">
                      {selectedTask.labels.map(l => (
                        <span key={l} className={cn("text-[10px] font-bold px-2.5 py-1 rounded-md", getLabelColor(l))}>{l}</span>
                      ))}
                    </div>
                  )}
                </div>

                <div className="grid grid-cols-2 md:grid-cols-4 gap-4 p-5 bg-muted/30 rounded-2xl border border-border/50">
                  <div>
                    <div className="text-[10px] font-black uppercase text-muted-foreground tracking-wider mb-1">Empresa</div>
                    <div className="font-bold text-sm text-foreground flex items-center gap-1.5"><Briefcase className="w-4 h-4 text-indigo-500" /> {selectedTask.companyName || '-'}</div>
                  </div>
                  <div>
                    <div className="text-[10px] font-black uppercase text-muted-foreground tracking-wider mb-1">Canal</div>
                    <div className="font-bold text-sm text-foreground">{selectedTask.salesChannel || '-'}</div>
                  </div>
                  <div>
                    <div className="text-[10px] font-black uppercase text-muted-foreground tracking-wider mb-1">Responsável</div>
                    <div className="font-bold text-sm text-foreground flex items-center gap-1.5"><User className="w-4 h-4 text-emerald-500" /> {selectedTask.responsible || '-'}</div>
                  </div>
                  <div>
                    <div className="text-[10px] font-black uppercase text-muted-foreground tracking-wider mb-1">Vencimento</div>
                    <div className="font-bold text-sm text-foreground flex items-center gap-1.5">
                      <Calendar className={cn("w-4 h-4", selectedTask.dueDate && isPast(parseISO(selectedTask.dueDate)) && selectedTask.status !== 'concluido' ? 'text-red-500' : 'text-amber-500')} /> 
                      {selectedTask.dueDate ? format(parseISO(selectedTask.dueDate), 'dd/MM/yyyy') : '-'}
                    </div>
                  </div>
                </div>

                {selectedTask.description && (
                  <div className="space-y-3">
                    <h3 className="text-sm font-black uppercase tracking-wider text-muted-foreground">Descrição</h3>
                    <div className="p-5 border border-border rounded-2xl shadow-sm text-sm text-foreground/80 leading-relaxed whitespace-pre-wrap">
                      {selectedTask.description}
                    </div>
                  </div>
                )}

                {subtasks.length > 0 && (
                  <div className="space-y-4">
                    <div className="flex items-center justify-between">
                      <h3 className="text-sm font-black uppercase tracking-wider text-muted-foreground">Subtarefas</h3>
                      <span className="text-sm font-black text-indigo-600">{selectedTask.progress}%</span>
                    </div>
                    <div className="w-full bg-muted rounded-full h-2 overflow-hidden">
                      <div className="bg-indigo-500 h-full rounded-full transition-all" style={{ width: `${selectedTask.progress}%` }}></div>
                    </div>
                    <div className="border border-border rounded-2xl shadow-sm overflow-hidden p-2">
                       {subtasks.map(st => (
                          <div key={st.id} className="flex items-center gap-3 p-3 hover:bg-muted/50 rounded-xl transition-colors">
                             <div className={cn("w-5 h-5 rounded-md flex items-center justify-center border", st.completed ? "bg-indigo-600 border-indigo-600" : "bg-transparent border-muted-foreground/30")}>
                                {st.completed && <CheckCircle2 className="w-3.5 h-3.5 text-white" />}
                             </div>
                             <span className={cn("text-sm font-medium", st.completed ? "line-through text-muted-foreground" : "text-foreground")}>{st.title}</span>
                          </div>
                       ))}
                    </div>
                  </div>
                )}

              </div>
             </>
           )}
        </DialogContent>
      </Dialog>
    </div>
  );
}
